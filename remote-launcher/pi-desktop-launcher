          failure("nonFastForward", "The remote rejected the reviewed update because its branch moved.");
        }
        if (transport?.httpProxy) {
          failure("remoteUnavailable", "Git could not reach the selected remote through the configured trusted proxy.");
        }
        failure("remoteUnavailable", "Git could not reach the selected remote.");
      }
      if (trackingUpdate?.error || trackingUpdate?.status !== 0) {
        failure("refreshFailed", `Push succeeded, but the local upstream ref could not be refreshed: ${detailOf(trackingUpdate)}`, true);
