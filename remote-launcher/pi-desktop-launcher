    for (const item of request.providers) {
      if (!hasOnlyKeys(item, ["providerId", "definition", "credential"]) ||
          !validId(item.providerId) || seen.has(item.providerId)) providerSyncFail("syncPayloadInvalid");
      seen.add(item.providerId); validateDefinition(item.definition); validateCredential(item.credential);
      const existing = modelsRoot.providers[item.providerId];
      if (existing !== undefined && !isObject(existing)) providerSyncFail("remoteModelsInvalid");
      validateExistingCredential(authRoot, item.providerId, existing);
      const hasEmbedded = isObject(existing) && Object.hasOwn(existing, "apiKey");
      const hasAuth = Object.hasOwn(authRoot, item.providerId);
      const nextDefinition = JSON.parse(JSON.stringify(item.definition));
      if (hasEmbedded) nextDefinition.apiKey = existing.apiKey;
      modelsRoot.providers[item.providerId] = nextDefinition;
      let credentialAction = "noCredential";
      const warnings = [];
      if (hasAuth || hasEmbedded) {
        credentialAction = "remoteCredentialPreserved";
        warnings.push("remoteCredentialPreserved");
      } else if (item.credential) {
        authRoot[item.providerId] = item.credential;
        credentialAction = isEnv(item.credential.key) ? "willInstallEnvironmentReference" : "willInstallApiKey";
      }
      warnings.push("remoteReloadRequired");
      results.push({ providerId: item.providerId, configUpdated: true, credentialAction, warnings });
    }
