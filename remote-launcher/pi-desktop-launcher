    payload = JSON.parse(process.env.PI_DESKTOP_LAUNCHER_PAYLOAD);
  } catch {
    fail("invalid launcher payload");
  }

  const CONTROL_CHAR = /[\u0000-\u001f\u007f]/;
  const MAX_REMOTE_PATH_BYTES = 4096;
