  }

  if (mode === "--supervise") {
    // Internal. Not advertised in --capabilities and not part of the desktop
    // contract; only --start-detached sets this variable.
    if (process.env.PI_DESKTOP_SUPERVISOR !== "1") taskFail("supervisorNotInvokable");
    const payload = decodeArgumentPayload();
    const taskId = payload.remoteTaskId;
    const directory = taskDir(taskId);
    const initial = readStatus(taskId);
    if (!initial) taskFail("taskNotFound");
    // Multiple idempotent start requests may race while status is still `starting`.
    // Exactly one supervisor owns the task; a dead owner's lock can be reclaimed.
    const supervisorLock = path.join(directory, "supervisor.lock");
    const claimSupervisor = () => {
      for (let attempt = 0; attempt < 2; attempt += 1) {
        let fd;
        try {
          fd = fs.openSync(supervisorLock, fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_EXCL | noFollow, 0o600);
          fs.writeFileSync(fd, `${process.pid}\n`);
          fs.fsyncSync(fd);
          fs.closeSync(fd);
          fsyncDirectory(directory);
          return true;
        } catch (error) {
          if (fd !== undefined) { try { fs.closeSync(fd); } catch { /* already closed */ } }
          if (error?.code !== "EEXIST") taskFail("taskWriteFailed", error?.message);
          let owner = null;
          try { owner = Number(fs.readFileSync(supervisorLock, "utf8").trim()); } catch { /* retry stale lock */ }
          if (pidAlive(owner)) return false;
          try { fs.unlinkSync(supervisorLock); fsyncDirectory(directory); } catch { return false; }
        }
      }
      return false;
    };
    if (!claimSupervisor()) process.exit(0);

    let liveBase = 1;
    let nextSequence = 1;
    let segmentBytes = 0;
    let totalBytes = 0;
    let segmentFd = null;
    let journalBroken = false;
    let dirty = false;
    let stopRequestedAt = null;
    let current = { ...initial };
    let lastStatusWrite = 0;

    const oldestBase = () => {
      const names = listSegments(directory);
      const match = names.length > 0 ? SEGMENT_PATTERN.exec(names[0]) : null;
      return match ? Number(match[1]) : liveBase;
    };
    const openLive = (base) => {
      const target = path.join(directory, segmentName(base));
      assertNotSymlink(target);
      segmentFd = fs.openSync(
        target,
        fs.constants.O_WRONLY | fs.constants.O_CREAT | fs.constants.O_APPEND | noFollow,
        0o600,
      );
      segmentBytes = fs.fstatSync(segmentFd).size;
    };
    const commit = (patch, force = false) => {
      current = {
        ...current,
        ...patch,
        journal: {
          liveSegment: segmentName(liveBase),
          baseSequence: oldestBase(),
          liveBaseSequence: liveBase,
          nextSequence,
          totalBytes,
        },
      };
      const now = Date.now();
      if (!force && now - lastStatusWrite < STATUS_THROTTLE_MS) return;
      lastStatusWrite = now;
      dirty = false;
      // The journal is the record of truth; a failed status write must not take
      // the task down with it.
      try { writeStatus(taskId, current); } catch { /* retried by the heartbeat */ }
    };
    // Caps are byte-based, never per-line: an 8513-char JSONL line is legitimate,
    // and a split line makes replay resume mid-object.
    const enforceTaskCap = () => {
      while (totalBytes > TASK_MAX_BYTES) {
        const names = listSegments(directory);
        if (names.length <= 1) return;
        const oldest = path.join(directory, names[0]);
        let size = 0;
        try { size = fs.statSync(oldest).size; } catch { /* raced */ }
        try { fs.unlinkSync(oldest); } catch { return; }
        totalBytes -= size;
      }
    };
    const append = (record) => {
      if (journalBroken) return;
      const line = Buffer.from(`${JSON.stringify(record)}\n`);
      if (segmentBytes > 0 && segmentBytes + line.length > SEGMENT_MAX_BYTES) {
        try {
          fs.closeSync(segmentFd);
          liveBase = nextSequence;
          openLive(liveBase);
        } catch { journalBroken = true; return; }
      }
      try { fs.writeSync(segmentFd, line); } catch { journalBroken = true; return; }
      segmentBytes += line.length;
      totalBytes += line.length;
      nextSequence += 1;
      dirty = true;
      if (totalBytes > TASK_MAX_BYTES) enforceTaskCap();
    };
    const emit = (stream, bytes, truncated = false) => {
      // Strip one trailing CR so a CRLF host does not embed \r in every record.
      const end = bytes.length > 0 && bytes[bytes.length - 1] === 0x0d ? bytes.length - 1 : bytes.length;
      const record = { ts: Date.now(), stream, data: bytes.subarray(0, end).toString("utf8") };
      if (truncated) record.truncated = true;
      append(record);
    };
    const framer = (stream, observe = null) => {
      let pending = Buffer.alloc(0);
      return {
        push(chunk) {
          pending = pending.length > 0 ? Buffer.concat([pending, chunk]) : chunk;
          for (;;) {
            const index = pending.indexOf(0x0a);
            if (index === -1) break;
            const record = pending.subarray(0, index);
            if (observe) observe(record);
            emit(stream, record);
            pending = pending.subarray(index + 1);
          }
          if (pending.length > MAX_EVENT_BYTES) {
            emit(stream, pending.subarray(0, MAX_EVENT_BYTES), true);
            pending = Buffer.alloc(0);
          }
        },
        flush() {
          if (pending.length === 0) return;
          if (observe) observe(pending);
          emit(stream, pending);
          pending = Buffer.alloc(0);
        },
      };
    };

    const abort = (errorCode, detail) => {
      commit({ state: "exited", busy: false, exitCode: null, exitSignal: null, stale: true, errorCode, error: detail ?? null }, true);
      process.exit(0);
    };
    try { openLive(liveBase); } catch (error) { abort("taskWriteFailed", error?.message); }
    try {
      fs.writeFileSync(path.join(directory, "supervisor.pid"), `${process.pid}\n`, { mode: 0o600 });
    } catch { /* the pid also lives in status.json */ }

    const args = ["--mode", "rpc"];
    if (typeof payload.resumePath === "string" && payload.resumePath.length > 0) {
      args.push("--session", payload.resumePath);
    }
    let child;
    try {
      child = spawn(payload.piExecutable, args, { cwd: payload.cwd, stdio: ["pipe", "pipe", "pipe"] });
    } catch (error) {
      abort("piStartFailed", error?.message);
    }
    let closed = false;
    // libuv detects an exec failure through a pipe before spawn() returns, so an
    // unusable `piExecutable` leaves pid undefined here rather than surfacing only
    // as an async error. Checking it synchronously is what keeps --start-detached
    // from ever observing `running` for a pi that never existed.
    if (child.pid === undefined) abort("piStartFailed", `cannot execute ${payload.piExecutable}`);
    child.once("error", (error) => {
      if (closed) return;
      abort("piStartFailed", error?.message);
    });
    try {
      fs.writeFileSync(path.join(directory, "pi.pid"), `${child.pid}\n`, { mode: 0o600 });
    } catch { /* the pid also lives in status.json */ }
    append({ ts: Date.now(), stream: "control", event: "started", pid: child.pid, supervisorPid: process.pid });
    commit({ state: "running", pid: child.pid, supervisorPid: process.pid }, true);


    let activityEpoch = 0;
    let activityActive = current.busy === true;
    let anonymousPending = 0;
    const pendingTurns = new Map();
    const publishBusy = () => {
      commit({ busy: activityActive || anonymousPending > 0 || pendingTurns.size > 0 }, true);
    };
    const reserveTurn = (bytes) => {
      let command;
      try { command = JSON.parse(bytes.toString("utf8")); } catch { return; }
      if (command?.type !== "prompt" && command?.type !== "follow_up") return;
      const requestId = typeof command.id === "string" ? command.id : null;
      activityEpoch += 1;
      if (requestId) pendingTurns.set(requestId, activityEpoch);
      else anonymousPending += 1;
      publishBusy();
    };
    const observeActivity = (bytes) => {
      let event;
      try { event = JSON.parse(bytes.toString("utf8")); } catch { return; }
      if (event?.type === "response" && event.success === false && typeof event.id === "string") {
        if (!pendingTurns.delete(event.id)) return;
        activityEpoch += 1;
        publishBusy();
        return;
      }
      if (event?.type === "agent_start") {
        activityEpoch += 1;
        activityActive = true;
        const first = pendingTurns.keys().next();
        if (!first.done) pendingTurns.delete(first.value);
        else if (anonymousPending > 0) anonymousPending -= 1;
        publishBusy();
        return;
      }
      if (event?.type === "agent_settled" || (event?.type === "agent_end" && event.willRetry !== true)) {
        activityEpoch += 1;
        activityActive = false;
        publishBusy();
      }
    };
    const outFramer = framer("stdout", observeActivity);
    const errFramer = framer("stderr");
    child.stdout.on("data", (chunk) => outFramer.push(chunk));
    child.stderr.on("data", (chunk) => errFramer.push(chunk));

    // O_RDWR, not O_RDONLY: a read-only FIFO reports EOF every time its last
    // writer closes, which would end input forwarding after the first --send.
    try {
      const net = require("node:net");
      let inputPending = Buffer.alloc(0);
      const forwardInput = (line) => {
        let envelope = null;
        try { envelope = JSON.parse(line.toString("utf8")); } catch { /* bare Pi command */ }
        const keyed = isObject(envelope) && hasOnlyTaskKeys(envelope,
          ["type", "idempotencyKey", "fingerprint", "attemptId", "payload"]) &&
          envelope.type === "pi-desktop-send-v1";
        if (!keyed) {
          reserveTurn(line);
          try { child.stdin.write(Buffer.concat([line, Buffer.from("\n")])); } catch { /* pi is gone */ }
          return;
        }
        if (!/^[A-Za-z0-9_.-]{1,128}$/.test(envelope.idempotencyKey) ||
            !/^[a-f0-9]{32}$/.test(envelope.fingerprint) ||
            !/^[a-f0-9]{32}$/.test(envelope.attemptId) || typeof envelope.payload !== "string") return;
        let payloadBytes;
        try { payloadBytes = Buffer.from(envelope.payload, "base64"); } catch { return; }
        if (payloadBytes.length === 0 || payloadBytes.length > MAX_SEND_BYTES ||
            crypto.createHash("sha256").update(payloadBytes).digest("hex").slice(0, 32) !== envelope.fingerprint) return;
        const sendsPath = path.join(directory, "stdin.sends.json");
        const now = Date.now();
        const records = readSendRecords(sendsPath).filter((record) => record.expiresAt > now);
        const existing = records.find((record) => record.key === envelope.idempotencyKey);
        if (existing) return;
        records.push({ key: envelope.idempotencyKey, fingerprint: envelope.fingerprint,
          attemptId: envelope.attemptId, state: "pending", bytes: payloadBytes.length, sentAt: now,
          expiresAt: now + SEND_IDEMPOTENCY_TTL_MS });
        while (records.length > MAX_SEND_RECORDS) records.shift();
        try { writeSendRecords(sendsPath, directory, records); } catch { return; }
        reserveTurn(payloadBytes);
        const finalizeSend = (error) => {
          const current = readSendRecords(sendsPath).filter((record) => record.expiresAt > Date.now());
          const index = current.findIndex((record) => record.key === envelope.idempotencyKey &&
            record.fingerprint === envelope.fingerprint && record.attemptId === envelope.attemptId);
          if (index === -1 || current[index].state !== "pending") return;
          if (error) current.splice(index, 1);
          else current[index] = { ...current[index], state: "sent" };
          try { writeSendRecords(sendsPath, directory, current); } catch { /* sender times out conservatively */ }
        };
        try { child.stdin.write(payloadBytes, finalizeSend); } catch (error) { finalizeSend(error); }
      };
      const observeInput = (chunk) => {
        inputPending = inputPending.length > 0 ? Buffer.concat([inputPending, chunk]) : chunk;
        for (;;) {
          const index = inputPending.indexOf(0x0a);
          if (index === -1) break;
          forwardInput(inputPending.subarray(0, index));
          inputPending = inputPending.subarray(index + 1);
        }
        if (inputPending.length > MAX_SEND_BYTES * 2) inputPending = Buffer.alloc(0);
      };
      const fifoFd = fs.openSync(
        path.join(directory, "stdin.pipe"),
        fs.constants.O_RDWR | (fs.constants.O_NONBLOCK ?? 0),
      );
      const socket = new net.Socket({ fd: fifoFd, readable: true, writable: false });
      socket.on("error", () => { /* a broken pipe must not kill the task */ });
      socket.on("data", observeInput);
      socket.unref();
    } catch { /* no FIFO on this platform; --send reports it */ }
    // Deliberately ignored. Run mode forwards SIGHUP to its pi child, and that
    // forwarding is exactly what makes an attached task die with its channel — so
    // a detached task must invert it. SIGTERM and SIGINT still mean a real stop.
    process.on("SIGHUP", () => { /* survive channel loss */ });
    const requestStop = (signal) => {
      if (stopRequestedAt !== null) return;
      stopRequestedAt = Date.now();
      append({ ts: stopRequestedAt, stream: "control", event: "stop_requested", signal });
      commit({ state: "stopping", stopRequestedAt }, true);
      try { child.kill("SIGTERM"); } catch { /* already gone */ }
      setTimeout(() => { try { child.kill("SIGKILL"); } catch { /* already gone */ } }, 4_000).unref();
    };
    process.on("SIGTERM", () => requestStop("SIGTERM"));
    process.on("SIGINT", () => requestStop("SIGINT"));

    const heartbeat = setInterval(() => { if (dirty) commit({}, true); }, STATUS_THROTTLE_MS);
    heartbeat.unref();

    child.once("close", (code, signal) => {
      closed = true;
      outFramer.flush();
      errFramer.flush();
      const exitedAt = Date.now();
      append({ ts: exitedAt, stream: "control", event: "exited", exitCode: code ?? null, exitSignal: signal ?? null });
      // Both stop timestamps are recorded because they were measured 17x apart:
      // pi acknowledges `abort` in 204ms, but the process only disappears ~3.4s
      // later. The ack proves generation stopped; this proves the session file was
      // released.
      commit({
        state: "exited",
        busy: false,
        exitCode: code ?? null,
        exitSignal: signal ?? null,
        stopConfirmedAt: stopRequestedAt === null ? null : exitedAt,
      }, true);
      try { fs.closeSync(segmentFd); } catch { /* already closed */ }
      process.exit(0);
    });
    return;
  }

  taskFail("taskPayloadInvalid", `unhandled task mode ${mode}`);
}
