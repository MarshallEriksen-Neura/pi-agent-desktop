      !["stage", "unstage", "stageBatch", "unstageBatch", "commit"].includes(request.operation)) {
    failure("invalidRequest", "Repository mutation payload is invalid.");
  }
  const batchMutation = ["stageBatch", "unstageBatch"].includes(request.operation);
  if (["stage", "unstage"].includes(request.operation)) {
    if (!relative(request.path) || (request.originalPath != null && !relative(request.originalPath)) ||
        request.files != null || request.diffKind != null || request.message != null || request.remote != null
