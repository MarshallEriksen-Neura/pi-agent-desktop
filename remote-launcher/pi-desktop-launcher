      if (!branch || !head) failure("detachedHead", "Pushing is unavailable from detached HEAD.");
      if (head !== request.expectedHeadOid) failure("staleGeneration", "HEAD changed; refresh before pushing.");
      if (!latest.upstreamRemote || !latest.upstreamBranch) failure("noUpstream", "The current branch has no configured upstream.");
      if (!validRemoteRefName(repoRoot, latest.upstreamRemote) || !validLocalBranchName(repoRoot, latest.upstreamBranch)) {
        failure("unsafeRepositoryConfiguration", "The configured upstream cannot form the reviewed push refspec.");
      }
      if (latest.upstreamRemote !== request.expectedUpstreamRemote || latest.upstreamBranch !== request.expectedUpstreamBranch) {
        failure("staleGeneration", "The push destination changed; refresh before pushing.");
      }
      if ((latest.upstreamOid ?? null) !== (request.expectedUpstreamOid ?? null)) {
        failure("staleGeneration", "The upstream ref changed; fetch and review before pushing.");
      }
      if (latest.upstreamOid === head) failure("nothingToPush", "The current branch has no commits to push.");
      if (latest.upstreamOid && !isAncestor(repoRoot, latest.upstreamOid, head)) {
        failure("nonFastForward", "The reviewed upstream is not an ancestor of the reviewed HEAD.");
