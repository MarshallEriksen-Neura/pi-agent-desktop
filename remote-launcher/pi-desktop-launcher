    typeof value === "string" &&
    value.length > 0 &&
    Buffer.byteLength(value) <= MAX_REMOTE_PATH_BYTES &&
    !CONTROL_CHAR.test(value);

  const mode = process.env.PI_DESKTOP_LAUNCHER_MODE;
