{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi",
  "version": "0.9.2",
  "identifier": "dev.pi.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Pi",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["mica", "acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPLOCALDATA/pets/**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MkY0RDcxRTU4NTE4NkUKUldSdUdJWGxjVTB2dDJpUU9hUEcreG9zdmIzSnZpOFAvMU11U0Z2U2xKWTlIa25lR1hwTHd4WG0K",
      "endpoints": [
        "https://github.com/MarshallEriksen-Neura/pi-agent-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
