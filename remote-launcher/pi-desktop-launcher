          Object.keys(value).length > 0 && Object.keys(value).length <= MAX_PROVIDER_SYNC_MODELS &&
          Object.entries(value).every(([key, item]) => isEnvName(key) &&
            typeof item === "string" && item.length > 0 && Buffer.byteLength(item) <= MAX_PROVIDER_SYNC_STRING_BYTES));
