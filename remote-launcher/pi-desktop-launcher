      fs.rmdirSync(lockPath);
      return true;
    } catch { return false; }
  };
  let locked = false;
  let ownsLock = false;
  const releaseLock = () => {
    if (!ownsLock) return;
    try { safeRemove(lockOwnerPath); } catch {}
    try { fs.rmdirSync(lockPath); } catch {}
    ownsLock = false;
    locked = false;
  };
