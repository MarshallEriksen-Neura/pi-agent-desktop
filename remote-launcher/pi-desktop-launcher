    }
    // Re-enters this same file at its installed absolute path, so the supervisor
    // is never a second copy of the source that could drift from this one.
    const self = process.env.PI_DESKTOP_LAUNCHER_SELF;
    if (typeof self !== "string" || self.length === 0) taskFail("supervisorStartFailed", "launcher path is unknown");
    const supervisor = spawn("sh", [self, "--supervise", Buffer.from(JSON.stringify(payload)).toString("base64")], {
