{
  "name": "@pi/remote-control-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript contracts for Pi LAN remote control clients and gateways.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pairing": {
      "types": "./dist/pairing.d.ts",
      "default": "./dist/pairing.js"
    },
    "./projects": {
      "types": "./dist/projects.d.ts",
      "default": "./dist/projects.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "default": "./dist/tasks.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {}
}
