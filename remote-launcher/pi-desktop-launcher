      stdio: "ignore",
      env: { ...process.env, PI_DESKTOP_SUPERVISOR: "1" },
    });
    supervisor.unref();
    const deadline = Date.now() + SUPERVISOR_START_TIMEOUT_MS;
    const started = (current) => taskReply({
      ok: true,
      remoteTaskId: taskId,
      pid: current.pid,
      supervisorPid: current.supervisorPid,
      startedAt: current.startedAt,
      stdinReady: fifoReady,
      state: current.state,
      exitCode: current.exitCode ?? null,
