# dependencies
/node_modules
apps/*/node_modules
packages/*/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# next.js auto-generated
next-env.d.ts

# production
/build
/.tmp/
/packages/*/dist/
apps/*/dist

# mobile app (Capacitor) — native projects are regenerated via `cap add`
apps/*/android
apps/*/ios
apps/*/.vite

# tauri / rust
/src-tauri/target
/src-tauri/gen
# defensive: any crate-level cargo build output
target/

# typescript
*.tsbuildinfo
next-env.d.ts.timestamp

# env / secrets
.env
.env*.local
*.pem

# pi CLI local state (sessions, cache)
.pi/

# updater signing keys (local only; pubkey lives in tauri.conf.json)
src-tauri/.tauri-keys/

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# agent / tool metadata (local only, not project source)
.firecrawl/
.ragcode/
.omc/
.omx/
.claude/
.comate/
.agents/
skills-lock.json
.trae/