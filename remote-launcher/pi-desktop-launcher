    }

    if (request.operation === "createBranch" || request.operation === "switchBranch") {
      const oid = (value) => typeof value === "string" && (value.length === 40 || value.length === 64) && /^[0-9a-f]+$/i.test(value);
      if (typeof request.branchName !== "string" || request.branchName.length === 0 || request.branchName.length > 255
          || request.branchName.trim() !== request.branchName || request.branchName.startsWith("-")
          || /[\u0000-\u001f\u007f]/.test(request.branchName) || request.remote != null
          || request.expectedUpstreamOid != null
          || (request.operation === "createBranch" && !oid(request.expectedHeadOid))
          || (request.operation === "switchBranch" && request.expectedHeadOid != null)) {
        failure("invalidRequest", "Branch operation requires one local branch name and, when creating, the reviewed HEAD.");
      }
      if (!validLocalBranchName(repoRoot, request.branchName)) failure("invalidRequest", "Local branch name is invalid.");
      const exists = metadata.branches.some((branch) => branch.name === request.branchName);
      if (request.operation === "createBranch") {
        if (exists) failure("branchExists", "A local branch with this name already exists.");
        const reviewedHead = optionalGitText(repoRoot, ["rev-parse", "--verify", "HEAD"]);
        if (!reviewedHead) failure("detachedHead", "HEAD has no commit.");
        if (reviewedHead !== request.expectedHeadOid) failure("staleGeneration", "HEAD changed; refresh before creating the branch.");
        let hooksDir;
        try { hooksDir = fs.mkdtempSync(path.join(os.tmpdir(), "pi-desktop-hooks-")); }
        catch (error) { failure("gitUnavailable", error.message); }
        let result;
        try { result = git(repoRoot, ["-c", `core.hooksPath=${hooksDir}`, "branch", "--no-track", request.branchName, reviewedHead]); }
        finally { try { fs.rmdirSync(hooksDir); } catch { /* cleanup */ } }
        if (result.error || result.status !== 0) failure("gitUnavailable", detailOf(result));
      } else {
        if (!exists) failure("branchNotFound", "The selected local branch no longer exists.");
        let hooksDir;
        try { hooksDir = fs.mkdtempSync(path.join(os.tmpdir(), "pi-desktop-hooks-")); }
        catch (error) { failure("gitUnavailable", error.message); }
        let result;
        try {
          result = git(repoRoot, ["-c", `core.hooksPath=${hooksDir}`, "switch", "--no-guess", "--no-recurse-submodules", request.branchName], MAX_REPOSITORY_STATUS_BYTES);
        } finally { try { fs.rmdirSync(hooksDir); } catch { /* cleanup */ } }
